rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }

    function isWorker() {
      return isAuthenticated() && getRole() == 'worker';
    }

    function isCitizen() {
      return isAuthenticated() && getRole() == 'citizen';
    }

    // Check if admin is scoped to a specific municipality (null = global admin)
    function hasAdminMuniAccess(municipalityId) {
      return isAdmin() && (
        getUserData().municipalityId == null ||
        getUserData().municipalityId == municipalityId
      );
    }

    // ─── Users Collection ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── Municipalities ───────────────────────────────────────────────────
    match /municipalities/{muniId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Departments ──────────────────────────────────────────────────────
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Issues Collection ────────────────────────────────────────────────
    match /issues/{issueId} {
      // Anyone can read issues (for public civic transparency)
      allow read: if true;

      // Any authenticated user can report a new issue
      allow create: if isAuthenticated() &&
        request.resource.data.reportedBy == request.auth.uid;

      // Admin (scoped), the original reporter, OR assigned worker can update
      allow update: if
        hasAdminMuniAccess(resource.data.municipalityId) ||
        request.auth.uid == resource.data.reportedBy ||
        (isWorker() && resource.data.assignedWorkerId == request.auth.uid);

      // Only admin or reporter can delete
      allow delete: if
        hasAdminMuniAccess(resource.data.municipalityId) ||
        request.auth.uid == resource.data.reportedBy;
    }

    // ─── Tasks Collection ─────────────────────────────────────────────────
    match /tasks/{taskId} {
      // Admin can read all tasks; worker can read only their own
      allow read: if isAdmin() ||
        (isWorker() && resource.data.workerId == request.auth.uid);

      // Only admin can create tasks (assignment)
      allow create: if isAdmin();

      // Admin or assigned worker can update task status
      allow update: if isAdmin() ||
        (isWorker() && resource.data.workerId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ─── Issue Clusters (legacy) ──────────────────────────────────────────
    match /issueClusters/{clusterId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin() ||
        (isWorker() && resource.data.assignedWorker == request.auth.uid) ||
        (isWorker() && resource.data.acceptedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── Status History ───────────────────────────────────────────────────
    match /statusHistory/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ─── Internal Notes ───────────────────────────────────────────────────
    match /internalNotes/{noteId} {
      allow read: if isAdmin() ||
        (isWorker() && resource.data.workerId == request.auth.uid);
      allow create: if isAdmin() || isWorker();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── Audit Logs ───────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── Integrity Reports ────────────────────────────────────────────────
    match /integrity_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── Gamification / Points ────────────────────────────────────────────
    match /userPoints/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || request.auth.uid == userId;
    }

    match /leaderboard/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Civic Memory ─────────────────────────────────────────────────────
    match /civicMemory/{memId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
